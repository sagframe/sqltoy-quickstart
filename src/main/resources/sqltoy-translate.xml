<?xml version="1.0" encoding="UTF-8"?>
<sagacity
	xmlns="https://www.sagframe.com/schema/sqltoy-translate"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://www.sagframe.com/schema/sqltoy-translate https://sagframe.github.io/schema/sqltoy-translate.xsd">
	<!-- caches have a default expiry of 1 hour, so only frequently changed caches need timely refresh checks -->
	<cache-translates>
		<!-- a cache can also be provided by a spring bean; dictionary-style caches can take a type parameter -->
		<!-- <service-translate cache="dictKeyNameCache" service="dictService"
			method="getDictByType" keep-alive="30" /> -->
		<!-- or by a rest service -->
		<!-- <rest-translate cache="dictKeyNameCache" url="http://xxxx/common/getDictByType"/> -->

		<!-- cache loaded directly by a sql query -->
		<sql-translate cache="dictKeyName"
			datasource="dataSource">
			<sql>
			<![CDATA[
				--#not_debug#--
				select t.DICT_KEY,t.DICT_NAME,t.STATUS
				from SQLTOY_DICT_DETAIL t
		        where t.DICT_TYPE=:dictType
				order by t.SHOW_INDEX
			]]>
			</sql>
		</sql-translate>

		<!-- staffId -> staffName cache -->
		<sql-translate cache="staffIdName"
			datasource="dataSource">
			<sql>
			<![CDATA[
				--#not_debug#--
				select STAFF_ID,STAFF_NAME,STATUS
				from SQLTOY_STAFF_INFO
			]]>
			</sql>
		</sql-translate>
		<!-- organId -> organName cache -->
		<sql-translate cache="organIdName"
			datasource="dataSource">
			<sql>
			<![CDATA[
				--#not_debug#--
				select ORGAN_ID,ORGAN_NAME from SQLTOY_ORGAN_INFO order by SHOW_INDEX
			]]>
			</sql>
		</sql-translate>
	</cache-translates>

	<!-- cache update checkers: sql, service or rest based -->
	<!-- cluster-time-deviation: clock tolerance across cluster nodes, default 1 second -->
	<cache-update-checkers cluster-time-deviation="1">
		<!-- sql based incremental update detection -->
		<sql-increment-checker cache="organIdName"
			check-frequency="60" datasource="dataSource">
			<sql><![CDATA[
			--#not_debug#--
			select ORGAN_ID,ORGAN_NAME
			from SQLTOY_ORGAN_INFO
			where UPDATE_TIME >=:lastUpdateTime
			]]></sql>
		</sql-increment-checker>

		<!-- incremental update: changed rows update the cache directly -->
		<sql-increment-checker cache="staffIdName"
			check-frequency="30" datasource="dataSource">
			<sql><![CDATA[
			--#not_debug#--
			select STAFF_ID,STAFF_NAME,STATUS
			from SQLTOY_STAFF_INFO
	        where UPDATE_TIME >=:lastUpdateTime
			]]></sql>
		</sql-increment-checker>

		<!-- incremental update with inner grouping: the first column of the result is the group -->
		<sql-increment-checker cache="dictKeyName"
			check-frequency="15" has-inside-group="true" datasource="dataSource">
			<sql><![CDATA[
			--#not_debug#--
			select t.DICT_TYPE,t.DICT_KEY,t.DICT_NAME,t.STATUS
			from SQLTOY_DICT_DETAIL t
	        where t.UPDATE_TIME >=:lastUpdateTime
			]]></sql>
		</sql-increment-checker>
		<!-- the checker may also be service or rest based:
		<service-checker service="cacheChangeCheckService" method="getChangeCache" check-frequency="15"/>
		<rest-checker url="http://xxxx/getChangeCache" check-frequency="15" username="" password=""/>
		-->
	</cache-update-checkers>
</sagacity>

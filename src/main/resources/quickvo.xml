<?xml version="1.0" encoding="UTF-8"?>
<quickvo xmlns="http://www.sagframe.com/schema/quickvo"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.sagframe.com/schema/quickvo https://sagframe.github.io/schema/quickvo.xsd">
	<property name="project.version" value="1.0.0" />
	<property name="project.name" value="sqltoy-quickstart" />

	<!-- default package prefix -->
	<property name="project.package" value="com.sqltoy" />
	<property name="include.schema" value="false" />
	<!-- whether setters return this (fluent style, default true) -->
	<property name="field.support.linked.set" value="true" />
	<!-- custom api-doc annotation templates (swagger-v3/swagger-v2 are built-in) -->
	<api-doc>
		<imports value="io.swagger.v3.oas.annotations.media.Schema" />
		<doc-class-template>
		<![CDATA[@Schema(name="${className}",description="${tableRemark!""}")]]>
		</doc-class-template>
		<doc-field-template>
		<![CDATA[@Schema(name="${fieldName}",description="${colRemark!""}",nullable=${nullable})]]>
		</doc-field-template>
	</api-doc>

	<!-- points at an in-memory H2 database by default: the INIT=RUNSCRIPT in the url creates the
	     lesson tables (mock/h2/schema-h2.sql) when the connection opens — nothing to install.
	     To run against a real database (e.g. a legacy one you are migrating), change url/driver/schema/catalog
	     and add the matching JDBC driver to the pom. -->
	<datasource name="quickstart" url="jdbc:h2:mem:quickvogen;INIT=RUNSCRIPT FROM 'src/main/resources/mock/h2/schema-h2.sql'"
		driver="org.h2.Driver" schema="PUBLIC" catalog="" username="sa" password="" />

	<!-- dist: where the generated java sources are written -->
	<tasks dist="src/main/java" encoding="UTF-8">
		<!-- active toggles the task; include/exclude are table-name patterns; api-doc selects annotations -->
		<task active="true" author="zhongxuchen" include="^SQLTOY_\w+|^LESSON_\w+"	datasource="quickstart" api-doc="swagger-v3">
			<!-- substr removes a table-name prefix before building the class name #{subName} -->
			<entity package="${project.package}.lesson.gen"	substr="Sqltoy" name="#{subName}VO" lombok-chain="true"/>
		</task>
	</tasks>

	<!-- primary-key strategies: identity columns get a strategy automatically, others are inferred from
	     type and length. strategy: sequence (needs the sequence name) | assign (manual) |
	     generator (default 22-digit | nanotime 26-digit | snowflake | uuid | redis | custom class) -->
	<primary-key>
		<table name="SQLTOY_\w+|LESSON_\w+|SYS_\w+" strategy="generator" generator="default" />
		<!--<table name="xxxTABLE" strategy="sequence" sequence="SEQ_XXXX"/> -->
		<!--<table name="sys_staff_info" strategy="generator" generator="snowflake"/> -->
	</primary-key>

	<!-- Redis-based business primary keys with a specific rule (see Lesson 1 for the annotation form).
	     macros: @substr(${field},startIndex,length) @case(value,case1,value1,...) @df(yyMMdd) -->
	<business-primary-key>
		<!--<table name="LESSON_DEVICE_ORDER" column="ORDER_ID" generator="redis" signature="PO@df(yyMMdd)" length="16" /> -->
	</business-primary-key>

	<!-- type mapping: native-types matches database-specific type names; jdbc-type the java.sql.Types value
	     used in @Column; java-type the property type; import-types extra imports -->
	<type-mapping>
		<!-- one example kept: map BIGINT to BigInteger (snowflake-friendly) -->
		<sql-type native-types="BIGINT" jdbc-type="BIGINT" java-type="java.math.BigInteger" />
	</type-mapping>
</quickvo>

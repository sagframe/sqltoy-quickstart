<?xml version="1.0" encoding="utf-8"?>
<sqltoy xmlns="http://www.sagframe.com/schema/sqltoy"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.sagframe.com/schema/sqltoy https://sagframe.github.io/schema/sqltoy.xsd">
	<!-- database sharding demo -->
	<sql id="qstart_db_sharding_case">
		<sharding-datasource strategy="hashDataSource"
			params="userId" />
		<value>
			<![CDATA[
			select * from sqltoy_user_log t
			-- userId is the sharding key and therefore a mandatory condition
			where t.user_id=:userId
			#[and t.log_date>=:beginDate]
			#[and t.log_date<=:endDate]
				]]>
		</value>
	</sql>

	<!-- table sharding demo -->
	<sql id="qstart_sharding_table_case">
		<sharding-table tables="sqltoy_trans_info_15d"
			strategy="realHisTable" params="beginDate" />
		<value>
			<![CDATA[
			select * from sqltoy_trans_info_15d t
			where t.trans_date>=:beginDate
			#[and t.trans_date<=:endDate]
				]]>
		</value>
	</sql>

	<!-- tree-table recursive query demo -->
	<sql id="qstart_treeTable_search">
		<value>
			<![CDATA[
			select * from sqltoy_organ_info t
			where exists
			(
				select 1 from sqltoy_organ_info t1
				where t1.ORGAN_ID=t.ORGAN_ID
				and instr(t1.NODE_ROUTE,:nodeRoute)
			)
				]]>
		</value>
	</sql>

	<!-- fast pagination + pagination optimize demo -->
	<sql id="qstart_fastPage">
		<!-- pagination optimize: with identical query conditions the total record count is cached for a period,
		     so it is not re-queried on every call.
		     alive-max: how many distinct conditions keep a cached count; alive-seconds: how long a count stays alive
		     (e.g. 120 seconds; past the threshold it is queried again) -->
		<page-optimize parallel="true" alive-max="100"
			alive-seconds="120" />
		<!-- data masking: type selects a standard masking mode; mask-rate/mask-code customize the mask (default ***);
		     head-size/tail-size keep leading/trailing characters visible -->
		<secure-mask columns="address" type="address" />
		<secure-mask columns="tel_no" type="tel" />
		<value>
			<![CDATA[
			select t1.*,t2.ORGAN_NAME
			-- @fast() pages first and takes 10 rows (pageSize decides), then performs the join
			from @fast(select t.*
			           from sqltoy_staff_info t
			           where t.STATUS=1
			             #[and t.STAFF_NAME like :staffName]
			           order by t.ENTRY_DATE desc
			            ) t1
			left join sqltoy_organ_info t2 on  t1.organ_id=t2.ORGAN_ID
				]]>
		</value>
		<!-- for extremely special cases a custom count-sql can be provided for ultimate performance -->
		<!-- <count-sql></count-sql> -->
	</sql>


	<!-- this configuration is long, but most of it is comments explaining special usage -->
	<!-- combined cache-translate and cache-arg demo:
		1) translate codes into names via cache, avoiding joins — simpler sql and faster queries
		2) reverse-match exact codes from names via cache, avoiding a joined LIKE query -->
	<sql id="qstart_order_search">
		<!-- cache translate for device type:
			cache: the name of the cache definition;
			cache-type: for dictionary caches, the category filter;
			columns: the query field(s) to translate, comma-separated;
			cache-indexs: which column of the cache data holds the name (defaults to the second column, index 1) -->
		<translate cache="dictKeyName" cache-type="DEVICE_TYPE"
			columns="deviceTypeName" cache-indexs="1" />
		<!-- translate purchase/sale type -->
		<translate cache="dictKeyName"
			cache-type="PURCHASE_SALE_TYPE" columns="psTypeName" />
		<!-- translate order status -->
		<translate cache="dictKeyName" cache-type="ORDER_STATUS"
			columns="statusName" />
		<!-- translate staff names; one cache can translate several columns at once -->
		<translate cache="staffIdName"
			columns="staffName,createName" />
		<!-- translate organization names -->
		<translate cache="organIdName" columns="organName" />
		<filters>
			<cache-arg cache-name="staffIdName" param="staffName" prior-match-equal="true"
				alias-name="staffIds">
				<!-- optional: this filter EXCLUDES matching entries from the reverse match.
					compare-param: a condition parameter name or a fixed value;
					cache-index: which cache column to compare against; compare-type: eq or neq.
					here: exclude staff whose status (3rd column) equals 1 (invalid) -->
				<filter compare-param="1" cache-index="2" compare-type="eq" />
			</cache-arg>
			<!-- never write to_str(trans_date)>=:xxx — sqltoy provides date/number type conversion,
			     and the format option simplifies this class of processing -->
			<to-date params="beginDate" format="yyyy-MM-dd"
				increment-time="24" increment-unit="hours" />
			<!-- add 1 day to the end date, equivalent to trans_date<='yyyy-MM-dd 23:59:59' -->
			<to-date params="endDate" format="yyyy-MM-dd" increment-time="1" increment-unit="days"/>
		</filters>
		<value>
			<![CDATA[
			select 	ORDER_ID,
					DEVICE_TYPE,
					-- a functional style also works at the database level (for inspiration):
					-- @translate(dictKeyNameCache,DEVICE_TYPE,DEVICE_TYPE) deviceTypeName
					DEVICE_TYPE deviceTypeName,-- device type name
					PS_TYPE,
					PS_TYPE as psTypeName, -- purchase/sale type name
					TOTAL_CNT,
					TOTAL_AMT,
					BUYER,
					SALER,
					TRANS_DATE,
					DELIVERY_TERM,
					STAFF_ID,
					STAFF_ID staffName, -- staff name
					ORGAN_ID,
					ORGAN_ID organName, -- organization name
					CREATE_BY,
					CREATE_BY createName, -- creator name
					CREATE_TIME,
					UPDATE_BY,
					UPDATE_TIME,
					STATUS,
					STATUS statusName -- status name
			from sqltoy_device_order t
			where #[t.ORDER_ID=:orderId]
			      -- organizations the current user may access (data permission, usually kept in the user session after login)
				  #[and t.ORGAN_ID in (:authedOrganIds)]
				  #[and t.STAFF_ID in (:staffIds)]
				  #[and t.TRANS_DATE>=:beginDate]
				  #[and t.TRANS_DATE<:endDate]
				]]>
		</value>
	</sql>

	<!-- group summary demo -->
	<sql id="qstart_group_summary_case">
		<value>
			<![CDATA[
			select t.fruit_name,t.order_month,t.sale_count,t.sale_price,t.total_amt
			from sqltoy_fruit_order t
			order by t.fruit_name ,t.order_month
			]]>
		</value>
		<summary sum-columns="sale_count,sale_price,total_amt"
			reverse="true" sum-site="top" skip-single-row="true">
			<!-- keep the hierarchy order from high to low -->
			<global sum-label="Total"  label-column="fruit_name" />
			<group group-column="fruit_name" sum-label="Subtotal"
				label-column="fruit_name" />
			<group group-column="" sum-label="" label-column="" />
		</summary>
	</sql>

	<!-- column-to-column period-over-period demo -->
	<sql id="qstart_cols_relative_case">
		<value>
			<![CDATA[
			select t.fruit_name,t.order_month,t.sale_count,t.sale_price,t.total_amt
			from sqltoy_fruit_order t
			order by t.fruit_name ,t.order_month
			]]>
		</value>
		<!-- rotate rows into columns: order_month becomes column headings, three measures under each month -->
		<pivot start-column="sale_count" end-column="total_amt"
			group-columns="fruit_name" category-columns="order_month" />
		<!-- compute period-over-period between columns -->
		<cols-chain-relative group-size="3"
			reduce-one="true" relative-indexs="1,2" start-column="1"
			format="#.00%" />
	</sql>

	<!-- column-to-column period-over-period demo (mysql variant) -->
	<sql id="mysql_qstart_cols_relative_case">
		<value>
			<![CDATA[
			select t.fruit_name,t.order_month,t.sale_count,t.sale_price,t.total_amt
			from sqltoy_fruit_order t
			order by t.fruit_name ,t.order_month
			]]>
		</value>
		<!-- rotate rows into columns: order_month becomes column headings, three measures under each month -->
		<pivot start-column="sale_count" end-column="total_amt"
			group-columns="fruit_name" category-columns="order_month" />
		<!-- compute period-over-period between columns -->
		<cols-chain-relative group-size="3"
			reduce-one="true" relative-indexs="1,2" start-column="1"
			format="#.00%" />
	</sql>

	<!-- row-to-row period-over-period demo -->
	<sql id="qstart_rows_relative_case">
		<value>
			<![CDATA[
				select t.fruit_name,t.order_month,t.sale_count,t.sale_price,t.total_amt
				from sqltoy_fruit_order t
				order by t.order_month desc,t.fruit_name
			]]>
		</value>
		<!-- rows are chained per fruit_name group -->
		<rows-chain-relative group-column="fruit_name"
			relative-columns="sale_count,total_amt" />
	</sql>
	<!-- rows to columns (pivot) -->
	<sql id="qstart_pivot_case">
		<value>
			<![CDATA[
				select t.fruit_name,t.order_month,t.sale_count,t.sale_price,t.total_amt
				from sqltoy_fruit_order t
				order by t.fruit_name ,t.order_month
			]]>
		</value>
		<!-- rotate rows into columns: order_month becomes column headings, three measures under each month -->
		<pivot start-column="sale_count" end-column="total_amt"
			group-columns="fruit_name" category-columns="order_month" />
	</sql>
	<!-- columns to rows (unpivot) -->
	<sql id="qstart_unpivot_case">
		<value>
			<![CDATA[
				select t.fruit_name,t.order_month,t.sale_count,t.sale_price,t.total_amt
				from sqltoy_fruit_order t
				order by t.order_month desc,t.fruit_name
			]]>
		</value>
		<unpivot
			columns-to-rows="sale_count:sale count,sale_price:sale amount,total_amt:total sales"
			new-columns-labels="indexName,indexValue" />
	</sql>

	<!-- link demo: concatenate column values per group; for pagination use @fast() first, then link -->
	<sql id="qstart_link_case">
		<value>
			<![CDATA[
				select t.ORGAN_ID ,t.ORGAN_ID ORGAN_NAME, t.STAFF_NAME , t.SEX_TYPE,t.SEX_TYPE sexTypeName from sqltoy_staff_info t
				order by t.ORGAN_ID
			]]>
		</value>
		<!-- several columns can be concatenated separately; with cache translate the values are translated first.
		     prerequisite: the sql itself provides a sensible ordering.
		     id-columns: the grouping column; columns: the columns to concatenate;
		     sign: the separator; distinct: deduplicate while concatenating -->
		<link id-columns="ORGAN_ID" columns="STAFF_NAME,sexTypeName"
			sign="," distinct="true" />
		<translate cache="dictKeyName" columns="sexTypeName"
			cache-type="SEX_TYPE" />
		<translate cache="organIdName" columns="ORGAN_NAME" />
	</sql>

	<sql id="qstart_link_case_simple">
		<value>
			<![CDATA[
				select    concat('\'',t1.ORGAN_ID,' \'') organIds
                from   sqltoy_ORGAN_info t1
			]]>
		</value>
		<!-- single-column extreme case -->
		<link columns="organIds" sign="," />
	</sql>

	<!-- @loop forms: @loop(:loopParam,loopContent) and @loop(:loopParam,loopContent,linkSign);
	     to make inner splitting unambiguous wrap the parts in quotes or braces:
	     @loop(:loopParam," loopContent ","linkSign") -->
	<sql id="qstart_loop_sql">
		<value>
			<![CDATA[
				select ORDER_ID
				       @loop(:fields,",:fields[i]")
				from sqltoy_device_order t
				where #[t.ORDER_ID=:orderId]
				  -- @blank(:param) plays along with sqltoy's #[] null-removal: when the value is not null
				  -- @blank() is replaced by an empty string (@if can be used instead of @blank)
				  #[@if(size(:staffIds)>0) and (@loop(:staffIds," t.STAFF_ID=':staffIds[i]' "," or ","1","100"))]
				  #[@blank(:startDates)
				       and ( @loop(:startDates,
				                     " t.TRANS_DATE between STR_TO_DATE(':startDates[i]','%Y-%m-%d')
				                       and STR_TO_DATE(':endDates[i]','%Y-%m-%d') " ,
				                       " or "))]
			]]>
		</value>
	</sql>

	<!-- decrypt fields when the sql returns a pojo with encrypted properties -->
	<sql id="qstart_secure_decrypt">
		<!-- decryption config -->
		<secure-decrypt columns="tel_no,home_address" />
		<value>
			<![CDATA[
				select * from sqltoy_secure_case
			]]>
		</value>
	</sql>
</sqltoy>
